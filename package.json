{
	"name": "stickerpack",
	"version": "0.0.1",
	"scripts": {
		"dev": "npm run build:lib && vite dev",
		"build": "npm run build:lib && vite build",
		"build:lib": "vite build -c vite.lib.config.js && vite build -c vite.script.config.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"prepack": "npm run build:lib",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"build:extension": "node scripts/build-extension.js",
		"dev:extension": "node scripts/build-extension.js --watch"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"./dist/stickerpack.js"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./element": "./dist/element.js",
		"./stickerpack.js": "./dist/stickerpack.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^5.6.3",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"happy-dom": "^20.14.5",
		"mdsvex": "^0.12.3",
		"svelte": "^5.0.0",
		"typescript": "^5.3.2",
		"vite": "^7.0.4",
		"vitest": "^3.2.3"
	},
	"keywords": [
		"stickers",
		"web-annotation",
		"custom-element"
	]
}
